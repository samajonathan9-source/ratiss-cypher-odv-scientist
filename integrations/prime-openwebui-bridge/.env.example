# Pont local uniquement
HOST=127.0.0.1
PORT=8787
PRIME_AGENT_BIN=prime-agent
PYTHON_BIN=python3
RATISS_WORKSPACE=./workspace
RATISS_MAX_READ_BYTES=5242880

# Optionnel : active l’orchestration Nemotron + Hermes via OpenRouter.
# Ne jamais committer la vraie clé.
OPENROUTER_API_KEY=
RATISS_OPENROUTER_PLANNER=nvidia/nemotron-3-ultra-550b-a55b:free
RATISS_OPENROUTER_EXECUTOR=nousresearch/hermes-3-llama-3.1-405b:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT_SECONDS=30

# URL utilisée par le panneau Linux Svelte.
VITE_RATISS_BRIDGE_URL=http://127.0.0.1:8787
